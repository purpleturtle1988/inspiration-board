{
  "manifest_version": 3,
  "name": "Inspiration Board",
  "version": "1.0",
  "description": "Bilder per Rechtsklick zur Inspiration Board Inbox senden",
  "permissions": ["contextMenus", "storage", "notifications"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Inspiration Board"
  },
  "icons": {
    "16": "icon_16.png",
    "48": "icon_48.png",
    "128": "icon_128.png"
  }
}
